{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tigerpro.local/schemas/pipeline_dag.schema.json",
  "title": "TigerPro Edge Pipeline DAG",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "source.rtsp",
              "detect.yolo",
              "track.bytetrack",
              "logic.alert",
              "logic.vlm_gate",
              "composite.mtmc",
              "sink.overlay",
              "sink.db",
              "sink.webhook",
              "sink.mqtt"
            ]
          },
          "config": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string" }
          },
          {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        ]
      }
    }
  }
}
