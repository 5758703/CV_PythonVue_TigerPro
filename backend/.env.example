# Copy to .env and fill real values
SECRET_KEY=change-me-to-a-random-secret
# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=DB_PASSWORD
DB_NAME=cv_python_tigerpro
# HuggingFace 访问令牌（拉取受限/私有模型权重时用，需先在模型页获批访问权）
# 获取：https://huggingface.co/settings/tokens
HF_TOKEN=
# ModelScope（模搭社区）访问令牌（拉取受限模型权重时用）
# 获取：https://modelscope.cn/my/myaccesstoken
MODELSCOPE_TOKEN=
# Roboflow API Key（拉取 Universe 模型权重 / 标注工具推送）
# 获取：https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=
# Roboflow Public API Key（可选，前端/公开场景）
ROBOFLOW_PUBLIC_API_KEY=
# Roboflow 工作区 slug（标注工具推送时可选，留空则用默认 workspace）
ROBOFLOW_WORKSPACE=
# CVAT（模型训练-数据标注-CVAT 工具）：云端一般为 https://app.cvat.ai
CVAT_URL=
# Personal Access Token（推荐）：形如 xxxx.yyyy，平台会使用 Bearer 鉴权
CVAT_TOKEN=
# 可选强制鉴权：bearer | token（默认：token 含 "." 用 Bearer，否则用 Token）
# CVAT_AUTH_SCHEME=
# 若无 Token，可用用户名密码
CVAT_USERNAME=
CVAT_PASSWORD=
# 可选：本机 X-AnyLabeling 可执行命令（仅提示用，导出/导入不依赖）
XANYLABELING_CMD=
# Ultralytics YOLO CPU 热路径推理后端（跟踪/车辆/告警视频）
# auto=优先 OpenVINO（失败回退 .pt）；torch=强制 PyTorch；openvino=强制 OV
# 若图片检测报 “best_openvino_* is not a supported model format”，请设为 torch，
# 并删除 uploads/models/**/best_openvino_* 错误缓存目录后重启。
YOLO_INFER_BACKEND=auto
# OpenVINO 精度：fp16（默认）| int8（需校准，可能掉点）
YOLO_OPENVINO_PRECISION=fp16
YOLO_OPENVINO_IMGSZ=640
# 火箭回收跟踪：一级箭体参考高度（米），用于视频检测中像素速度换算为米/秒
ROCKET_STAGE_HEIGHT_M=47
# DeepSeek（检测结果 AI 分析报告）API Key
# 获取：https://platform.deepseek.com/api_keys
# 留空时 AI 报告自动降级为案例库兜底（功能仍可用）
DEEPSEEK_API_KEY=
# Qwen-VL 缺陷诊断（OpenAI 兼容多模态，默认阿里云百炼 Token Plan 国内）
# 留空时诊断自动降级为规则化结构化报告（YOLO/分割仍可用）
QWEN_VL_API_KEY=
# 也可使用 DASHSCOPE_API_KEY 作为回退
# DASHSCOPE_API_KEY=
# 国内 Token Plan（默认）
QWEN_VL_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3.8-max-preview
# 国际 Token Plan（需切换时取消注释并替换上方 BASE_URL / KEY）
# QWEN_VL_INTL_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# QWEN_VL_INTL_API_KEY=
# 进入深度诊断队列的检测置信度门控
DEFECT_SUSPICIOUS_CONF=0.45
# ---- EMQX / MQTT（流水线 sink.mqtt；默认关闭）----
# EMQX Cloud Serverless 需 TLS + CA；本地开源版可 MQTT_TLS=0、端口 1883
MQTT_ENABLED=0
MQTT_BROKER=xxxx.ala.cn-shenzhen.emqxsl.cn
MQTT_PORT=8883
MQTT_TLS=1
# CA 证书路径（相对 backend 或绝对路径）；EMQX Cloud 控制台下载
MQTT_CA_CERTS=certs/emqxsl-ca.crt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=tigerpro-backend
MQTT_TOPIC_PREFIX=tigerpro/dev
MQTT_SITE=default
# WebSocket over TLS（前端/MQTTX 可选，后端 Publish 用 8883）
MQTT_WS_PORT=8084
# ---- 开放平台 / 对象存储（Open API）----
# local（默认）| s3（需 pip install boto3，并配置下方）
OBJECT_STORE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT=
S3_PREFIX=tigerpro/
OPEN_JOB_RETENTION_DAYS=7
