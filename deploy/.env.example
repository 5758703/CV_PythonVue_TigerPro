# Copy to deploy/.env and fill real values. Keep the real .env out of git.
# Only the values marked REQUIRED are enforced by docker-compose.yml (the
# `:?` checks); the rest are optional and the backend degrades gracefully.

# --- REQUIRED ---
# Persistent random secret shared by backend and gateway; must match the
# backend's own expectation (see backend/.env.example).
SECRET_KEY=change-me-in-prod
# MySQL root password; the same value is what backend/.env.example expects as DB_PASSWORD.
DB_PASSWORD=DB_PASSWORD

# Optional but recommended (defaults in docker-compose.yml shown):
DB_NAME=cv_python_tigerpro

# --- Model / third-party tokens (optional; leave blank to use local fallbacks) ---
HF_TOKEN=
MODELSCOPE_TOKEN=
ROBOFLOW_API_KEY=
DEEPSEEK_API_KEY=
QWEN_VL_API_KEY=
# CPU inference backend for the YOLO hot path: auto | torch | openvino
YOLO_INFER_BACKEND=auto

# The Vite dev ports the frontends expose are fixed in docker-compose.yml
# (5173 admin / 5174 home); no env override needed for the skeleton.
